# Copy this file to .env on the VM. Never commit the real .env file.

# Public web entry. The Java and FastAPI ports are intentionally not published.
OFFICECARE_WEB_PORT=8088
OFFICECARE_IMAGE_TAG=0.1.0
OFFICECARE_DOCUMENTS_PATH=/opt/officecare/data/documents
OFFICECARE_RUOYI_PROFILE_PATH=/opt/officecare/data/ruoyi-profile
OFFICECARE_JAVA_LOGS_PATH=/opt/officecare/logs/java

# Existing infrastructure on the external officecare-network.
OFFICECARE_MYSQL_HOST=officecare-mysql
OFFICECARE_MYSQL_PORT=3306
OFFICECARE_MYSQL_DATABASE=officecare_ai
OFFICECARE_MYSQL_USERNAME=officecare
OFFICECARE_MYSQL_PASSWORD=

OFFICECARE_REDIS_HOST=officecare-redis
OFFICECARE_REDIS_PORT=6379
OFFICECARE_REDIS_DATABASE=0
OFFICECARE_REDIS_PASSWORD=

# RabbitMQ is created by this compose project. Use a dedicated non-guest account.
# Port 5673 is for IDEA/local Java access; management UI is http://VM-IP:15673.
OFFICECARE_RABBITMQ_USERNAME=officecare
OFFICECARE_RABBITMQ_PASSWORD=
OFFICECARE_RABBITMQ_VHOST=/officecare
OFFICECARE_RABBITMQ_AMQP_PORT=5673
OFFICECARE_RABBITMQ_MANAGEMENT_PORT=15673
OFFICECARE_RABBITMQ_QUEUE_TYPE=quorum
OFFICECARE_RABBITMQ_CONSUMER_CONCURRENCY=1
OFFICECARE_RABBITMQ_PREFETCH_COUNT=1
OFFICECARE_RABBITMQ_OUTBOX_BATCH_SIZE=20
OFFICECARE_RABBITMQ_MAX_PUBLISH_ATTEMPTS=10
OFFICECARE_RABBITMQ_RETRY_INITIAL_DELAY_SECONDS=30
OFFICECARE_RABBITMQ_RETRY_MAX_DELAY_SECONDS=600

# Use the reachable Milvus endpoint. If its container is on officecare-network,
# prefer http://<milvus-container-name>:19530; otherwise use the VM endpoint.
OFFICECARE_MILVUS_URI=http://<milvus-container-name>:19530
OFFICECARE_MILVUS_TOKEN=
OFFICECARE_MILVUS_DATABASE=default
OFFICECARE_MILVUS_COLLECTION=officecare_document_chunks_v1

# PostgreSQL container already created for the LangGraph checkpointer.
OFFICECARE_AGENT_MEMORY_ENABLED=true
OFFICECARE_AGENT_POSTGRES_DSN=postgresql://officecare_agent:change-me@officecare-agent-postgres:5432/officecare_agent
OFFICECARE_AGENT_POSTGRES_POOL_SIZE=5
OFFICECARE_AGENT_RECENT_MESSAGE_LIMIT=12
OFFICECARE_AGENT_SUMMARY_TRIGGER_MESSAGES=20

# Internal and application secrets. Generate long random values independently.
OFFICECARE_AI_SERVICE_TOKEN=
OFFICECARE_SECURITY_TOKEN_SECRET=
OFFICECARE_DRUID_USERNAME=
OFFICECARE_DRUID_PASSWORD=

# Document parser.
OFFICECARE_DOCUMENT_PARSER=mineru
OFFICECARE_MINERU_BASE_URL=https://mineru.net
OFFICECARE_MINERU_API_TOKEN=
OFFICECARE_MINERU_MODEL_VERSION=vlm
OFFICECARE_MINERU_LANGUAGE=ch
OFFICECARE_MINERU_IS_OCR=false
OFFICECARE_MINERU_ENABLE_TABLE=true
OFFICECARE_MINERU_ENABLE_FORMULA=false
OFFICECARE_MINERU_REQUEST_TIMEOUT_SECONDS=60
OFFICECARE_MINERU_POLL_INTERVAL_SECONDS=5
OFFICECARE_MINERU_TIMEOUT_SECONDS=1800
OFFICECARE_MINERU_MAX_RESULT_SIZE_MB=200
OFFICECARE_MINERU_MAX_PAGES_PER_PART=200

# Embedding and chat providers.
OFFICECARE_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
OFFICECARE_EMBEDDING_API_KEY=
OFFICECARE_EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-8B
OFFICECARE_EMBEDDING_DIMENSION=4096
OFFICECARE_EMBEDDING_BATCH_SIZE=8
OFFICECARE_EMBEDDING_TIMEOUT_SECONDS=60

OFFICECARE_CHAT_BASE_URL=https://api.deepseek.com
OFFICECARE_CHAT_API_KEY=
OFFICECARE_CHAT_MODEL=deepseek-v4-pro
OFFICECARE_CHAT_TEMPERATURE=0.1
OFFICECARE_CHAT_TIMEOUT_SECONDS=120
OFFICECARE_CHAT_MAX_TOKENS=1200
OFFICECARE_AGENT_MAX_STEPS=8

# Redis RAG answer cache.
OFFICECARE_REDIS_ENABLED=true
OFFICECARE_REDIS_CONNECT_TIMEOUT_SECONDS=2
OFFICECARE_REDIS_SOCKET_TIMEOUT_SECONDS=2
OFFICECARE_RAG_CACHE_TTL_SECONDS=3600
OFFICECARE_RAG_CACHE_NAMESPACE=officecare:ai:rag-answer:v1

# Retrieval parameters proven by the local evaluation rounds.
OFFICECARE_CHUNK_SIZE=800
OFFICECARE_CHUNK_OVERLAP=100
OFFICECARE_RAG_TOP_K=5
OFFICECARE_RAG_SCORE_THRESHOLD=0.45
OFFICECARE_RAG_DENSE_CANDIDATE_LIMIT=100
OFFICECARE_RAG_LEXICAL_SCAN_LIMIT=5000
OFFICECARE_RAG_LEXICAL_CANDIDATE_LIMIT=100
OFFICECARE_RAG_LEXICAL_SCORE_THRESHOLD=0.18
OFFICECARE_RAG_NEIGHBOR_WINDOW=2
OFFICECARE_RAG_CONTEXT_MAX_CHARS=8000

# Optional LangSmith tracing. Keep inputs and outputs hidden for production-like demos.
OFFICECARE_LANGSMITH_ENABLED=false
OFFICECARE_LANGSMITH_API_KEY=
OFFICECARE_LANGSMITH_ENDPOINT=https://api.smith.langchain.com
OFFICECARE_LANGSMITH_PROJECT=officecare-ai
OFFICECARE_LANGSMITH_HIDE_INPUTS=true
OFFICECARE_LANGSMITH_HIDE_OUTPUTS=true

# Runtime tuning.
OFFICECARE_MAX_DOCUMENT_SIZE_MB=30
OFFICECARE_JAVA_CACHE_ENABLED=true
OFFICECARE_JAVA_CACHE_REFERENCE_TTL=30m
OFFICECARE_JAVA_OPTS=-Xms256m -Xmx768m -Dfile.encoding=UTF-8
OFFICECARE_REFERER_ALLOWED_DOMAINS=localhost,127.0.0.1
